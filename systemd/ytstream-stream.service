[Unit]
Description=YTStream Streaming Service
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=ytstream
WorkingDirectory=/opt/ytstream
ExecStart=/opt/ytstream/svc_stream.sh
Restart=always
RestartSec=5
StartLimitIntervalSec=30
StartLimitBurst=10
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
